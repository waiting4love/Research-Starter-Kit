   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">因此，建议单独写一节 Problem Formulation。</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
