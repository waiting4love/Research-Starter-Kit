   "type": "text"
  },
  "21": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">Overview 不需要写太多细节，而是要回答：</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
