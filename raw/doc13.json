   "type": "heading2"
  },
  "29": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">AI 论文通常会出现很多字母、符号、变量、集合、函数和下标。如果不提前定义清楚，读者后面读公式会非常吃力。</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "text"
  },
