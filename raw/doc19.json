   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7342907534354694172\" data-leaf=\"true\">它完成后提示，可以让它自己配置一个 hook</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
