  "24": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" style=\"font-weight:bold;\" class=\" author-7342907534354694172\" data-leaf=\"true\">上下文(context)是当前这段对话，</span><span data-string=\"true\" class=\" author-7342907534354694172\" data-leaf=\"true\">临时的，会话越长越满、越慢，退出当前会话就没了</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "bullet"
  },
  "25": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" style=\"font-weight:bold;\" class=\" author-7342907534354694172\" data-leaf=\"true\">记忆(</span><span style=\"font-weight:bold;\" class=\" author-7342907534354694172\" data-leaf=\"true\"><span class=\"inline-code inline-code_start inline-code_end\" spellcheck=\"false\"><span data-string=\"true\">CLAUDE.md</span></span></span><span data-string=\"true\" style=\"font-weight:bold;\" class=\" author-7342907534354694172\" data-leaf=\"true\">)是写进文件的项目约定，</span><span data-string=\"true\" class=\" author-7342907534354694172\" data-leaf=\"true\">持久的、清空上下文也不丢</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "bullet"
  },
  "26": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span style=\"font-weight:bold;\" class=\" author-7342907534354694172\" data-leaf=\"true\"><span class=\"inline-code inline-code_start inline-code_end\" spellcheck=\"false\"><span data-string=\"true\">/compact</span></span></span><span data-string=\"true\" class=\" author-7342907534354694172\" data-leaf=\"true\"> → 压缩成摘要后继续，会话变慢 / 快满时用</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "bullet"
  },
  "27": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span style=\"font-weight:bold;\" class=\" author-7342907534354694172\" data-leaf=\"true\"><span class=\"inline-code inline-code_start inline-code_end\" spellcheck=\"false\"><span data-string=\"true\">/clear</span></span></span><span data-string=\"true\" class=\" author-7342907534354694172\" data-leaf=\"true\"> → 彻底清空，换全新会话</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "bullet"
  },
