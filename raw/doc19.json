  },
  "31": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span style=\"font-weight:bold;\" class=\" author-7342907534354694172\" data-leaf=\"true\"><span class=\"inline-code inline-code_start inline-code_end\" spellcheck=\"false\"><span data-string=\"true\">/export</span></span></span><span data-string=\"true\" class=\" author-7342907534354694172\" data-leaf=\"true\"> → 把当前所有会话内容导出成一个文件</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
