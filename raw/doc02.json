   "type": "heading2"
  },
  "44": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">论文管理</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
