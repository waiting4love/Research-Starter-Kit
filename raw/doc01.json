 "56": {
  "payload": {
   "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">Idea是否有效需要结果的支持，AI里面通常是理论分析与实验验证，我们课题组的方向以实验验证为主，这需要学生能够在日常读论文的过程中，</span><span data-string=\"true\" style=\"font-weight:bold;\" class=\" author-7076000738450669572 textHighlight textHighlight-pink-text textHighlight-ccmtoken-doc-textcolor-red\" data-leaf=\"true\">熟悉本领域的常用benchmark、典型对比方法的代码（多复现相关论文）、同时善用vibe coding工具</span><span data-string=\"true\" style=\"font-weight:bold;\" class=\" author-7076000738450669572\" data-leaf=\"true\">。</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
  },
  "type": "text"
 },
 "57": {
  "payload": {
   "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">为了充分验证idea的有效性，要设计周全的实验方案，并给出必要的分析与解释，例如：</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
  },
  "type": "text"
