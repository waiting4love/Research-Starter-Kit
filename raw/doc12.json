 "blocks": {
  "2": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">Related Work 不是文献罗列，也不是把读过的论文逐篇摘要。它的核心任务是帮助读者理解：</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "callout"
  },
  "3": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">Related Work 不是文献罗列，也不是把读过的论文逐篇摘要。它的核心任务是帮助读者理解：</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "text"
  },
  "4": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">本文处在什么研究脉络中。</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "ordered"
  },
  "5": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">已有方法可以分成哪些主要路线。</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "ordered"
  },
  "6": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">每条路线解决了什么问题，又留下了什么不足。</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "ordered"
  },
  "7": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">本文与已有工作的关系是什么：延续、区别、补充还是超越。</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "ordered"
  },
  "8": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" style=\"font-weight:bold;\" class=\" author-7076000738450669572 textHighlight textHighlight-pink-text textHighlight-ccmtoken-doc-textcolor-red\" data-leaf=\"true\">一句话说，Related Work 要回答：</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "text"
  },
  "9": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" style=\"font-weight:bold;\" class=\" author-7076000738450669572 textHighlight textHighlight-pink-text textHighlight-ccmtoken-doc-textcolor-red\" data-leaf=\"true\">“别人已经做了什么？我们的工作和他们有什么关系？为什么还需要我们的工作？”</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "text"
  },
  "10": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" style=\"font-weight:bold;\" class=\" author-7076000738450669572\" data-leaf=\"true\">Related Work = 分类 + 概括 + 代表工作 + 局限 + 本文定位。</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "text"
  },
  "11": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">Related Work 和 Introduction的区别</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "heading2"
  },
  "12": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">Introduction 中也会提到已有工作，但它的目的主要是引出研究问题和 gap</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "text"
  },
  "13": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">Related Work 的目的更具体：系统梳理与本文最相关的研究脉络，并定位本文贡献</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "text"
  },
  "14": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">可以这样区分：</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "text"
  },
  "15": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">Introduction：讲故事，建立动机</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "bullet"
  },
  "16": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">Related Work：画地图，说明位置</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "bullet"
  },
  "17": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "text"
  },
  "18": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">Related Works的常见组织结构</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "heading2"
  },
  "19": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">按研究方向组织</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "heading3"
  },
  "20": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">适合大多数论文，每一节对应一个研究方向</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "text"
  },
  "21": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">按方法类别组织</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "heading3"
  },
  "22": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">如果针对本文研究的问题，已经有大量的方法了，可以尝试按照不同的技术路线来组织，重点比较不同技术路线的假设、优势和限制。</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "text"
  },
  "23": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "text"
  },
  "24": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">每一段的推荐写法</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "heading2"
  },
  "25": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" style=\"font-weight:bold;\" class=\" author-7076000738450669572\" data-leaf=\"true\">Related Work 中的每一段通常可以按下面逻辑写：</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "text"
  },
  "26": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" style=\"font-weight:bold;\" class=\" author-7076000738450669572\" data-leaf=\"true\">先概括一个研究方向</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "ordered"
  },
  "27": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" style=\"font-weight:bold;\" class=\" author-7076000738450669572\" data-leaf=\"true\">再列举代表性工作</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "ordered"
  },
  "28": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" style=\"font-weight:bold;\" class=\" author-7076000738450669572\" data-leaf=\"true\">然后总结这些工作的特点</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "ordered"
  },
  "29": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" style=\"font-weight:bold;\" class=\" author-7076000738450669572\" data-leaf=\"true\">最后指出它们与本文的关系或局限</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "ordered"
  },
  "30": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">例如：</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "text"
  },
  "31": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">“已有研究从……角度研究了该问题。早期工作主要……；近期方法进一步……。这些方法在……方面取得了进展，但通常依赖……，因此难以处理……。与这些工作不同，本文关注……。”</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "text"
  },
  "32": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">写 Related Work 时要避免的问题</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "heading2"
  },
  "33": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" style=\"font-weight:bold;\" class=\" author-7076000738450669572\" data-leaf=\"true\">不要逐篇论文平铺直叙</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div><div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">错误写法：A 做了什么，B 做了什么，C 做了什么。</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div><div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">更好的写法：A、B、C 属于同一类方法，它们共同解决了什么问题，但仍存在什么限制。</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "ordered"
  },
  "34": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" style=\"font-weight:bold;\" class=\" author-7076000738450669572\" data-leaf=\"true\">不要只夸别人，也不要只批评别人</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div><div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">Related Work 的语气应客观。重点是定位本文，而不是证明别人都不行。</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "ordered"
  },
  "35": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" style=\"font-weight:bold;\" class=\" author-7076000738450669572\" data-leaf=\"true\">不要引用过多但没有分类</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div><div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">引用多不等于相关工作写得好。分类清楚比引用数量更重要。</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "ordered"
  },
  "36": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" style=\"font-weight:bold;\" class=\" author-7076000738450669572\" data-leaf=\"true\">不要把 Related Work 写成 Introduction 的重复</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div><div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">如果 Introduction 已经讲过动机，Related Work 应进一步展开技术路线和差异。</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "ordered"
  },
  "37": {
   "payload": {
    "zoneHTML": "<div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" style=\"font-weight:bold;\" class=\" author-7076000738450669572\" data-leaf=\"true\">不要只写相似工作，不写差异</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div><div class=\"ace-line\" data-node=\"true\" dir=\"auto\"><span data-string=\"true\" class=\" author-7076000738450669572\" data-leaf=\"true\">读者最关心的是：你的工作和这些论文到底有什么不同。</span><span data-string=\"true\" data-enter=\"true\" data-leaf=\"true\">​</span></div>"
   },
   "type": "ordered"
  },
  "38": {
